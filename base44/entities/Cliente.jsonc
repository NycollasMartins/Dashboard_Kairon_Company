{
  "name": "Cliente",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "email": {
      "type": "string",
      "description": "Email do cliente"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone do cliente"
    },
    "empresa": {
      "type": "string",
      "description": "Empresa do cliente"
    },
    "status": {
      "type": "string",
      "enum": [
        "lead",
        "qualificado",
        "ativo",
        "inativo"
      ],
      "default": "lead"
    },
    "responsavel": {
      "type": "string",
      "description": "Email do respons\u00e1vel"
    },
    "squad_id": {
      "type": "string",
      "description": "ID do squad respons\u00e1vel"
    },
    "entregaveis": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de entreg\u00e1veis do cliente"
    },
    "notas": {
      "type": "string",
      "description": "Notas sobre o cliente"
    }
  },
  "required": [
    "nome"
  ]
}