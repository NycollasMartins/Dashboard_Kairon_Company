{
  "name": "Tarefa",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo da tarefa"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da tarefa"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "em_andamento",
        "revisao",
        "concluida"
      ],
      "default": "pendente"
    },
    "prioridade": {
      "type": "string",
      "enum": [
        "baixa",
        "media",
        "alta",
        "urgente"
      ],
      "default": "media"
    },
    "prazo": {
      "type": "string",
      "format": "date",
      "description": "Data limite"
    },
    "responsavel": {
      "type": "string",
      "description": "Email do respons\u00e1vel"
    },
    "cliente_id": {
      "type": "string",
      "description": "ID do cliente vinculado"
    },
    "cliente_nome": {
      "type": "string",
      "description": "Nome do cliente vinculado"
    },
    "projeto_id": {
      "type": "string",
      "description": "ID do projeto vinculado"
    }
  },
  "required": [
    "titulo"
  ]
}