# Variáveis públicas do Expo (inlined no bundle do app). Copie para `.env`.
# Mesmos valores de apps/web/.env.local (Supabase → Project Settings → API).
# Builds via EAS leem os valores do bloco `env` de cada perfil em eas.json.
EXPO_PUBLIC_SUPABASE_URL=https://<seu-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<sua-anon-key>
