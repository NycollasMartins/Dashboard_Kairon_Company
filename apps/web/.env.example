# ====================================================================
# Variáveis de ambiente do app web (Vite). Copie para `.env.local` (dev) e
# configure as mesmas chaves no provedor de hospedagem (produção).
#
# Só variáveis com prefixo VITE_ são expostas ao front — e TODAS ficam
# embutidas no bundle público. Nunca coloque aqui segredos de servidor
# (service_role key, tokens de API, client secrets). Esses vivem como
# secrets das Edge Functions: veja supabase/functions/.env.example.
# ====================================================================

# --- Supabase (obrigatório) -----------------------------------------
# Dashboard do Supabase → Project Settings → API.
# A anon key é pública por design; a segurança vem das policies de RLS.
VITE_SUPABASE_URL=https://<seu-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<sua-anon-key>

# --- Convites (opcional) --------------------------------------------
# Base usada no link do e-mail de convite: ${VITE_SITE_URL}/aceitar-convite.
# Se vazio, usa window.location.origin (a origem de onde o convite é enviado).
# A URL precisa estar em Authentication → URL Configuration → Redirect URLs.
VITE_SITE_URL=http://localhost:5173

# --- Integração de anúncios (opcional) ------------------------------
# Qualquer valor diferente de 'false' (inclusive ausente) liga o MODO MOCK:
# dados simulados, sem chamar as Edge Functions meta-ads/google-ads.
# Use 'false' para chamar as APIs reais (exige os secrets das funções).
# VITE_ADS_USE_MOCK=true

# Receita estimada (R$) por conversão de anúncio — proxy de ROAS. Default: 80.
# VITE_RECEITA_POR_CONVERSAO=80
