# ====================================================================
# Variáveis de ambiente do app web (Vite). Copie para `.env` (dev) e
# configure as mesmas chaves no provedor de hospedagem (produção).
# Só variáveis com prefixo VITE_ são expostas ao front.
# ====================================================================

# Supabase (Project Settings → API)
VITE_SUPABASE_URL=https://tguefaugsocobaawoueq.supabase.co
VITE_SUPABASE_ANON_KEY=coloque_aqui_a_anon_key

# Base URL usada para montar o link do convite: ${VITE_SITE_URL}/aceitar-convite.
# DEV  -> http://localhost:5173
# PROD -> https://dashboard.kaironcompany.com.br
# Se vazio, cai para window.location.origin (a origem de onde o convite é enviado).
VITE_SITE_URL=http://localhost:5173

# Opcional (integração de anúncios): use 'false' para chamar a API real.
# VITE_ADS_USE_MOCK=true
