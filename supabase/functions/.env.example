# ====================================================================
# Secrets das Edge Functions (Deno). NUNCA versione o arquivo real.
#
# Produção:  supabase secrets set NOME=valor   (ou Dashboard → Edge Functions → Secrets)
# Local:     supabase functions serve --env-file supabase/functions/.env
#
# Preenchidos automaticamente pela plataforma (não defina manualmente):
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
# ====================================================================

# --- invite-user -----------------------------------------------------
# Fallback do redirect do convite quando o front não envia `origin`.
SITE_URL=https://<dominio-do-dashboard>

# --- generate-report (Relatórios com IA) -----------------------------
ANTHROPIC_API_KEY=<anthropic-api-key>

# --- google-calendar-oauth / google-calendar-sync --------------------
GOOGLE_CALENDAR_CLIENT_ID=<oauth-client-id>
GOOGLE_CALENDAR_CLIENT_SECRET=<oauth-client-secret>
# Opcional. Default: ${SUPABASE_URL}/functions/v1/google-calendar-oauth
# GOOGLE_CALENDAR_REDIRECT_URI=

# --- meta-ads --------------------------------------------------------
META_ACCESS_TOKEN=<system-user-token>
META_AD_ACCOUNT_ID=act_<id-da-conta>
# Opcional. Default: v21.0
# META_API_VERSION=v21.0

# --- google-ads ------------------------------------------------------
GOOGLE_ADS_DEVELOPER_TOKEN=<developer-token>
GOOGLE_ADS_CLIENT_ID=<oauth-client-id>
GOOGLE_ADS_CLIENT_SECRET=<oauth-client-secret>
GOOGLE_ADS_REFRESH_TOKEN=<refresh-token>
GOOGLE_ADS_CUSTOMER_ID=<somente-digitos>
# Opcional (conta MCC/manager)
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
